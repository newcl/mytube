# Copy to .env and fill in values
MYTUBE_BIND=:8080
MYTUBE_TOKEN=change-me-to-a-long-random-secret
MYTUBE_DB_PATH=./data/mytube.db
MYTUBE_DOWNLOAD_DIR=./data/downloads
MYTUBE_CONCURRENCY=3
MYTUBE_CORS_ORIGIN=https://mytube.elladali.com
MYTUBE_PUBLIC_BASE_URL=https://api.mytube.elladali.com
MYTUBE_STATE_DIR=./data
# Optional override. Native macOS packages otherwise use their packaged yt-dlp.
# MYTUBE_YTDLP_PATH=/opt/homebrew/bin/yt-dlp
# On macOS, use a live browser session instead of exporting cookies.
# MYTUBE_COOKIE_BROWSER=chrome
# MYTUBE_JS_RUNTIME=deno
